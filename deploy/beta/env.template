# Copy to backend/.env on the VPS. Replace every CHANGE_ME value before starting.
APP_ENV=production
BETA_MODE=true
BETA_QUOTA_MODE=daily
BETA_DOMAIN=momonihongo.app
PUBLIC_BASE_URL=https://momonihongo.app
APP_CORS_ORIGINS=
BETA_DB_PASSWORD=CHANGE_ME_URL_SAFE_RANDOM
AUTH_SECRET_KEY=CHANGE_ME_RANDOM_48_PLUS_CHARACTERS
BETA_INVITE_EMAILS=CHANGE_ME_EMAIL
BETA_LIVE_ENABLED=false
BETA_AUDIO_STORAGE_ENABLED=false
BETA_GAMES_ENABLED=false
GEMINI_API_KEY=CHANGE_ME_GEMINI_KEY
GEMINI_PROVIDER=developer
VERTEX_PROJECT_ID=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
SPEAKING_EVALUATION_MODEL=gemini-3.1-flash-lite
READING_AI_MODEL=gemini-3.5-flash-lite
SHADOWING_QUIZ_MODEL=gemini-3.1-flash-lite
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=NihonGO <no-reply@momonihongo.app>
SMTP_USERNAME=CHANGE_ME_BREVO_SMTP_LOGIN
SMTP_PASSWORD=CHANGE_ME_BREVO_SMTP_KEY
SMTP_SSL=false
SMTP_STARTTLS=true
SHADOWING_CPU_THREADS=2
TRANSLATION_DEVICE=cpu

# Optional dedicated YouTube egress; set privately on the server, never commit credentials.
SHADOWING_YOUTUBE_PROXY=

# Optional read-only Netscape cookies file; Docker path, never the cookie values.
SHADOWING_YOUTUBE_COOKIE_FILE=
