FROM node:22-bookworm-slim AS javascript
FROM python:3.12-slim-bookworm
COPY --from=javascript /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt /tmp/requirements.txt
COPY shadowing/requirements.txt /tmp/shadowing-requirements.txt
# This VPS has no GPU. Preinstall matching CPU wheels so the general
# requirements cannot resolve multi-GB CUDA packages from PyPI.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 60 torch==2.14.1 torchvision==0.29.1 \
      --index-url https://download.pytorch.org/whl/cpu
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 60 -r /tmp/requirements.txt -r /tmp/shadowing-requirements.txt
COPY . /app
ENV PYTHONUNBUFFERED=1 HF_HOME=/models/huggingface
CMD ["python", "-m", "shadowing.worker"]
