APP_ENV=development
# Private beta for up to 50 invited accounts. Enable only with a local database and test emails.
BETA_MODE=false
BETA_QUOTA_MODE=daily
BETA_DOMAIN=
# URL-safe value (letters, digits, - and _) for the private Compose PostgreSQL service.
BETA_DB_PASSWORD=
BETA_INVITE_EMAILS=
# Legacy USD mode is optional; daily mode does not read its price table or reserve.
BETA_GEMINI_PRICES_JSON=
BETA_LIVE_RESERVE_USD=
BETA_LIVE_ENABLED=false
# Compose beta can store signed, private audio objects in a persistent VPS volume.
BETA_AUDIO_STORAGE_ENABLED=false
AUDIO_LOCAL_ROOT=
BETA_GAMES_ENABLED=false
# Required for production web clients, e.g. https://app.example.com
APP_CORS_ORIGINS=
DATABASE_URL=postgresql+psycopg://nihongo:nihongo_local@localhost:5432/nihongo
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:5001
PORT=5001
FLASK_DEBUG=0
# Use developer for AI Studio or vertex for Google Cloud credit via standard Vertex AI.
GEMINI_PROVIDER=developer
VERTEX_PROJECT_ID=
# Vertex on the beta VPS reads /run/vertex-secrets/vertex.json through ADC.
# Conversation AI model is optional.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# Gemini model for conversation scoring and sentence feedback.
SPEAKING_EVALUATION_MODEL=gemini-3.1-flash-lite

# Local Mailpit inbox: http://localhost:8025. Use TLS + real credentials in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=NihonGO <no-reply@nihongoflow.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Set to an API version supported by your Meta app.
FACEBOOK_GRAPH_VERSION=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Gemini Live: server-side key only. Rebuild native app after installing audio dependencies.
GEMINI_API_KEY=
SHADOWING_TRANSLATION_MODEL=gemini-3.1-flash-lite
SHADOWING_QUIZ_MODEL=gemini-3.1-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
# Dedicated Developer API key for bounded Live sessions. Text AI can stay on Vertex.
GEMINI_LIVE_API_KEY=

# Docker Compose audio storage (run from the project root):
# docker compose --env-file backend/.env --profile audio up -d
RUSTFS_IMAGE=rustfs/rustfs:1.0.1
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Optional audio-localstack profile. Native persistence needs a paid license.
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_IMAGE=localstack/localstack:2026.8.0
# S3-compatible audio storage.
# For a physical phone, S3_PUBLIC_ENDPOINT_URL must use your computer's LAN IP.
# Keep the host unchanged after signing a URL. For AWS, leave both endpoints blank.
S3_BUCKET=nihongo-audio
VOCABULARY_S3_BUCKET=vocabulary-audio
# Local shadowing queue; audio is temporary and is never uploaded to S3.
SHADOWING_SQS_ENDPOINT=http://localhost:9324
SHADOWING_SQS_QUEUE_URL=
SHADOWING_WHISPER_MODEL=small
SHADOWING_CPU_THREADS=2
SHADOWING_MAX_SECONDS=1200
SHADOWING_JOB_TIMEOUT=2400
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_ADDRESSING_STYLE=path
# Match RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional override; default: backend/models/handwriting/best.pt (server only).
HANDWRITING_CHECKPOINT=

# Vocabulary game: LiveKit + Redis + server Cloud Speech-to-Text. See deploy/beta/GAME_VOICE.md.
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GAME_MEDIA_IP=127.0.0.1
GAME_REDIS_URL=
GAME_SOCKET_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Cloud Speech-to-Text V2 short/ja-JP for game answers (separate from Gemini Live).
# Leave empty to reuse VERTEX_PROJECT_ID. ADC uses GOOGLE_APPLICATION_CREDENTIALS.
GAME_SPEECH_PROJECT_ID=
# For local server-side recognition, point ADC to a service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Local-only LLM + Supertonic speaking experiment.
SPEAKING_TTS_EXPERIMENT=0
SUPERTONIC_TTS_ENABLED=false
SUPERTONIC_MODEL_DIR=

# Local sentence translation, provision with: flask --app app translation-download
TRANSLATION_MODEL_PATH=
TRANSLATION_DEVICE=auto

# Reading explanations and analysis; uses the existing GEMINI_API_KEY.
READING_AI_MODEL=gemini-3.5-flash-lite

# Optional dedicated YouTube egress; set privately on the server, never commit credentials.
SHADOWING_YOUTUBE_PROXY=

# Optional read-only Netscape cookies file; Docker path, never the cookie values.
SHADOWING_YOUTUBE_COOKIE_FILE=
