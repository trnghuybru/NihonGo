# Copy to .env without overwriting your existing OPENROUTER_API_KEY.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://nihongo:nihongo_local@localhost:5432/nihongo
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:5001
PORT=5001
FLASK_DEBUG=0
# Conversation AI. The key stays on the backend; model is optional.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Optional separate model for transcript feedback; empty uses OPENROUTER_MODEL.
SPEAKING_EVALUATION_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# text works without structured-output support; json_schema requires a compatible model.
SPEAKING_EVALUATION_FORMAT=json_schema

# Local Mailpit inbox: http://localhost:8025. Use TLS + real credentials in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=NihonGO <no-reply@nihongoflow.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Set to an API version supported by your Meta app.
FACEBOOK_GRAPH_VERSION=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Gemini Live: server-side key only. Rebuild native app after installing audio dependencies.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore

# Docker Compose audio storage (run from the project root):
# docker compose --env-file backend/.env --profile audio up -d
RUSTFS_IMAGE=rustfs/rustfs:1.0.1
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Optional audio-localstack profile. Native persistence needs a paid license.
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_IMAGE=localstack/localstack:2026.8.0
# S3-compatible audio storage.
# For a physical phone, S3_PUBLIC_ENDPOINT_URL must use your computer's LAN IP.
# Keep the host unchanged after signing a URL. For AWS, leave both endpoints blank.
S3_BUCKET=nihongo-audio
VOCABULARY_S3_BUCKET=vocabulary-audio
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_ADDRESSING_STYLE=path
# Match RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
