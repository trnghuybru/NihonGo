FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY games/requirements-worker.txt games/requirements-voice.txt /tmp/games/
RUN --mount=type=cache,target=/root/.cache/pip pip install --timeout 60 -r /tmp/games/requirements-worker.txt
COPY . /app
ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "games.voice_worker"]
