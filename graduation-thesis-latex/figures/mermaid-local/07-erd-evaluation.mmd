    conversation_sessions {
        uuid id PK "UUID"
        varchar_36 user_id FK "VARCHAR(36)"
        uuid scenario_id FK "UUID"
        uuid scenario_role_id FK "UUID"
        uuid retry_of_session_id FK "UUID; nullable"
        jsonb scenario_snapshot "JSONB"
        varchar_16 status "VARCHAR(16)"
        varchar_8 current_input_mode "VARCHAR(8)"
