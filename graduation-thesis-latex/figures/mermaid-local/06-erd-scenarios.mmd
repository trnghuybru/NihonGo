    scenario_roles {
        uuid id PK "UUID"
        uuid scenario_id FK "UUID"
        varchar_100 name "VARCHAR(100)"
        text description "TEXT"
        text ai_instructions "TEXT"
        text opening_message "TEXT; nullable"
    }

    conversation_sessions {
        uuid id PK "UUID"
        varchar_36 user_id FK "VARCHAR(36)"
