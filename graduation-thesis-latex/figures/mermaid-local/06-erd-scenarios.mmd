        bigint accumulated_active_ms "BIGINT"
        timestamp last_resumed_at "TIMESTAMP; nullable"
        timestamp updated_at "TIMESTAMP"
        timestamp created_at "TIMESTAMP"
        timestamp deleted_at "TIMESTAMP; nullable"
        timestamp audio_cleanup_after "TIMESTAMP; nullable"
    }

    users {
        varchar_36 id PK "VARCHAR(36)"
        varchar_100 name "VARCHAR(100)"
        varchar_254 email "VARCHAR(254)"
        varchar_20 phone "VARCHAR(20)"
        text password_hash "TEXT; nullable"
        boolean email_verified "BOOLEAN"
        boolean phone_verified "BOOLEAN"
        boolean active "BOOLEAN"
        bigint created_at "BIGINT"
    }

    scenario_categories ||..o{ scenarios : "category_id"
