---
title: Learning and Flashcard Collections
---
erDiagram
    direction TB

    %% Source: live local PostgreSQL catalog; schema public.
    %% Snapshot: 2026-11-25T13:12:14.564538+00:00
    %% PK = primary key; FK = foreign key; UK = single-column UNIQUE.
    %% Composite UNIQUE constraints appear as comments.

    users {
        varchar_36 id PK "VARCHAR(36)"
        varchar_100 name "VARCHAR(100)"
        varchar_254 email "VARCHAR(254)"
        varchar_20 phone "VARCHAR(20)"
        text password_hash "TEXT; nullable"
        boolean email_verified "BOOLEAN"
        boolean phone_verified "BOOLEAN"
        boolean active "BOOLEAN"
        bigint created_at "BIGINT"
    }

    learning_preferences {
        varchar_36 user_id PK,FK "VARCHAR(36)"
        varchar_16 level "VARCHAR(16)"
        varchar_24 goal "VARCHAR(24)"
        integer daily_minutes "INTEGER"
        bigint level_confirmed_at "BIGINT"
        bigint created_at "BIGINT"
        bigint updated_at "BIGINT"
        integer version "INTEGER"
    }

    learning_study_days {
        varchar_36 user_id PK,FK "VARCHAR(36)"
        date day PK "DATE"
        integer seconds "INTEGER"
        json intervals "JSON"
        bigint updated_at "BIGINT"
    }

    flashcard_decks {
        varchar_36 id PK "VARCHAR(36)"
        varchar_36 user_id FK "VARCHAR(36)"
        varchar_80 title "VARCHAR(80)"
        jsonb cards "JSONB"
        bigint updated_at "BIGINT"
    }

    flashcard_favorites {
        varchar_36 user_id PK,FK "VARCHAR(36)"
        varchar_16 source PK "VARCHAR(16)"
        varchar_128 target PK "VARCHAR(128)"
        jsonb card "JSONB"
        bigint created_at "BIGINT"
    }

    flashcard_reminder_preferences {
        varchar_36 user_id PK,FK "VARCHAR(36)"
        boolean enabled "BOOLEAN"
        integer hour "INTEGER"
        integer minute "INTEGER"
    }

    users ||--o| learning_preferences : "user_id"
    users ||--o{ learning_study_days : "user_id"
    users ||..o{ flashcard_decks : "user_id"
    users ||--o{ flashcard_favorites : "user_id"
    users ||--o| flashcard_reminder_preferences : "user_id"
